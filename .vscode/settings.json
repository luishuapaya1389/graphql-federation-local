{
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/opt/homebrew/opt/openjdk@21",
      "default": true
    }
  ],
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "files.autoSave": "afterDelay",
  "java.compile.nullAnalysis.mode": "automatic",
  "[java]": {
    "editor.tabSize": 4
  },
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "graphql-config.load.rootDir": ".",
  "yaml.schemas": {
    "kubernetes": "k8s/**/*.yaml"
  }
}